# Python 가상환경
.venv/

# Python 캐시
__pycache__/
*.pyc
*.pyo
*.pyd

# 실제 API Key 등 비밀정보
.env

# pytest 캐시
.pytest_cache/

# 로그 파일
*.log

# 원본 데이터
# API 수집 원본과 수동 다운로드 원본은 대용량이거나
# 다시 수집/다운로드할 수 있으므로 Git에서 제외함.
#
# 단, 4인 분업에서 팀원 D가 텍스트마이닝에 사용하는
# 익명 설문 원본 survey_reviews.csv는 팀원 간 공유가 필요하므로
# Git에 포함함.
#
# service_reviews.csv는 실제 서비스 DB에서 추출하는 운영 데이터이므로
# Git에 포함하지 않음.
data/raw/*
!data/raw/text/
data/raw/text/*
!data/raw/text/survey_reviews.csv

# 가격모델 학습용 대용량 중간 데이터
# 아래 파일들은 모델 학습 과정에서 생성되는 중간 CSV이며
# 다른 담당자와 운영 FastAPI가 직접 사용하지 않음.
# 필요하면 원본 데이터와 Feature로 다시 생성할 수 있음.
data/processed/*_training.csv

# 로컬 발표 확인용 이미지
outputs/*.png

# IDE 설정
.idea/
*.iml