# 로컬 가상환경·Python 캐시·비밀정보·IDE 설정을 Docker 이미지에서 제외함
.venv
__pycache__
*.pyc
*.pyo
*.pyd
.env
.git
.pytest_cache
.idea
*.iml

# 수집·학습·검증·테스트 코드는 로컬 전용이므로
# 운영 FastAPI 추론 이미지에서 제외함
collectors
training
checks
tests

# 재수집/다운로드 가능한 원본 데이터는
# 운영 FastAPI가 사용하지 않으므로 제외함
data/raw

# 가격모델 학습용 대용량 중간 CSV는
# 학습 완료 후 운영 FastAPI가 사용하지 않으므로 제외함
data/processed/*_training.csv

# 텍스트마이닝 과정의 병합 중간 CSV는
# 최종 JSON 생성 후 운영 FastAPI가 직접 사용하지 않으므로 제외함
data/processed/neighborhood_reviews.csv

# 발표용 이미지와 로그는 운영 이미지에서 제외함
outputs/*.png
*.log