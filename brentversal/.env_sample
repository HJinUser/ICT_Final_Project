# 환경 변수 "이름"을 맞추기 위한 샘플 파일입니다. 이 파일만 git 에 커밋합니다.
# 정보 보호를 위해 실제 값이 들어있는 .env 는 커밋하지 않습니다(.gitignore 등록됨).
#
# 사용법:
#   1) brentversal/ 위치에 .env 파일을 새로 만듭니다.
#   2) 아래 내용을 복사해 넣고 각자 환경에 맞는 실제 값을 채웁니다.
#   3) 키 이름은 application*.properties 의 ${...} 와 1:1로 대응합니다. 이름을 바꾸면 properties 도 함께 바꿔야 합니다.

# ===== DB (운영 프로파일: application-prod.properties) =====
# 로컬 프로파일(local)은 DB 값이 properties 에 하드코딩되어 있어 비워도 됩니다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ===== JWT (application.properties) =====
# 기본은 secrets/jwt-*.pem 파일 사용. 키 내용 직접 주입 시에만 아래 두 줄을 채움.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# ===== 메일 (application.properties) =====
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 소셜 로그인
# 로컬 카카오/구글/네이버 개발자 콘솔에서 발급받은 값을 채운다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ===== 국토교통부 실거래가 Open API =====
# 공공데이터포털에서 발급받은 Decoding 인증키를 입력한다.
MOLIT_API_KEY=
