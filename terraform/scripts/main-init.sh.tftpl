#!/usr/bin/env bash
# 중간 명령 실패·미정의 변수·Pipeline 오류를 즉시 중단
set -euo pipefail

# Terraform templatefile()에서 전달받는 MySQL 설정값
MYSQL_DATABASE="${mysql_database}"
MYSQL_ROOT_PASSWORD="${mysql_root_password}"

# apt 설치 과정의 대화형 입력 방지
export DEBIAN_FRONTEND=noninteractive

# 기존 Swap 제거 후 3GB Swap 재생성
swapoff /swapfile 2>/dev/null || true
rm -f /swapfile
fallocate -l 3G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
# 재부팅 후에도 Swap 자동 활성화
grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab

# Docker 설치에 필요한 기본 패키지와 공식 GPG Key 준비
apt-get update
apt-get install -y ca-certificates curl gnupg
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

# Ubuntu 버전에 맞는 Docker 공식 APT Repository 등록
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
apt-get update

# Docker Engine·CLI·Compose Plugin 설치 및 서비스 자동 시작
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker
# ubuntu 계정이 sudo 없이 Docker 명령을 사용할 수 있도록 docker 그룹 추가
usermod -aG docker ubuntu

# MySQL 데이터 영속화를 위한 Docker Volume 준비
docker volume create mysql-data >/dev/null
# 동일 이름의 기존 Container가 있으면 제거 후 새로 생성
docker rm -f mysql-db 2>/dev/null || true

# Spring Boot가 localhost:3306으로 연결할 MySQL Container 실행
docker run -d \
  --name mysql-db \
  -e MYSQL_ROOT_PASSWORD="$MYSQL_ROOT_PASSWORD" \
  -e MYSQL_ROOT_HOST="%" \
  -e MYSQL_DATABASE="$MYSQL_DATABASE" \
  -p 127.0.0.1:3306:3306 \
  -v mysql-data:/var/lib/mysql \
  --restart unless-stopped \
  mysql:8.0

# MySQL이 실제 요청을 받을 수 있을 때까지 최대 5분 대기
for i in $(seq 1 60); do
  if docker exec mysql-db mysqladmin ping -uroot -p"$MYSQL_ROOT_PASSWORD" --silent >/dev/null 2>&1; then
    echo "MySQL is ready"
    exit 0
  fi
  sleep 5
done

# 제한 시간 내 준비되지 않으면 user_data 실패 처리
echo "MySQL did not become ready in time" >&2
exit 1