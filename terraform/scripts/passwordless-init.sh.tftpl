#!/usr/bin/env bash
# 중간 명령 실패·미정의 변수·Pipeline 오류를 즉시 중단
set -euo pipefail

# Terraform에서 전달받는 Passwordless 초기 설정값
DOMAIN="${auth_domain}"
EXPECTED_EIP="${expected_eip}"
LE_EMAIL="${letsencrypt_email}"
KEYSTORE_PASS="${keystore_password}"

export DEBIAN_FRONTEND=noninteractive

# Passwordless EC2 메모리 여유 확보용 3GB Swap 구성
swapoff /swapfile 2>/dev/null || true
rm -f /swapfile
fallocate -l 3G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab

# Docker·Certbot·Java·OpenSSL 설치 준비
apt-get update
apt-get install -y ca-certificates curl gnupg certbot default-jdk openssl
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker
usermod -aG docker ubuntu

# EIP 연결과 auth 도메인 DNS 반영이 모두 완료될 때까지 최대 30분 대기
# EC2 Metadata는 IMDSv2 Token 방식 사용
READY=0
for i in $(seq 1 180); do
  TOKEN=$(curl -fsS -X PUT -H "X-aws-ec2-metadata-token-ttl-seconds: 60" http://169.254.169.254/latest/api/token 2>/dev/null || true)
  CURRENT_PUBLIC_IP=""
  if [ -n "$TOKEN" ]; then
    CURRENT_PUBLIC_IP=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4 2>/dev/null || true)
  fi
  DNS_IP=$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk 'NR==1 {print $1}' || true)

  if [ "$CURRENT_PUBLIC_IP" = "$EXPECTED_EIP" ] && [ "$DNS_IP" = "$EXPECTED_EIP" ]; then
    READY=1
    break
  fi

  echo "Waiting for EIP and DNS: current=$CURRENT_PUBLIC_IP dns=$DNS_IP expected=$EXPECTED_EIP"
  sleep 10
done

if [ "$READY" != "1" ]; then
  echo "EIP and DNS were not ready within 30 minutes" >&2
  exit 1
fi

# auth 도메인의 Lets Encrypt 인증서 발급
certbot certonly \
  --standalone \
  --non-interactive \
  --agree-tos \
  --no-eff-email \
  --email "$LE_EMAIL" \
  -d "$DOMAIN"

# X1280 Container에 Mount할 인증서 디렉터리 준비
mkdir -p /home/ssl
chmod 700 /home/ssl
cp "/etc/letsencrypt/live/$DOMAIN/fullchain.pem" /home/ssl/cert.pem
cp "/etc/letsencrypt/live/$DOMAIN/privkey.pem" /home/ssl/privkey.pem

# PEM 인증서를 PKCS12로 변환
openssl pkcs12 -export \
  -in /home/ssl/cert.pem \
  -inkey /home/ssl/privkey.pem \
  -out /home/ssl/tomcat.p12 \
  -name tomcat \
  -passout pass:"$KEYSTORE_PASS"

# X1280 Tomcat에서 사용할 Java Keystore 생성
rm -f /home/ssl/tomcat.keystore
keytool -importkeystore \
  -noprompt \
  -deststorepass "$KEYSTORE_PASS" \
  -destkeystore /home/ssl/tomcat.keystore \
  -srckeystore /home/ssl/tomcat.p12 \
  -srcstoretype PKCS12 \
  -srcstorepass "$KEYSTORE_PASS"

# Private Key와 Keystore 접근 권한 제한
chmod 600 /home/ssl/privkey.pem /home/ssl/tomcat.keystore /home/ssl/tomcat.p12
chmod 644 /home/ssl/cert.pem

# Passwordless 전용 Docker Network 준비 후 기존 Container 정리
docker network inspect some-network >/dev/null 2>&1 || docker network create some-network
docker rm -f server 2>/dev/null || true

# Passwordless X1280 Container 실행
# 인증서·설정·로그·DB 데이터는 Volume/Mount로 영속화
docker run -d --name server \
  --network some-network \
  --restart always \
  --cpus=1 \
  --cpuset-cpus="0" \
  --cpu-shares=1024 \
  --memory=1g \
  --memory-swap=2g \
  -e DOMAIN="$DOMAIN" \
  -e AUTH_KEYSTORE_FILE_PATH=/etc/opt/x1280/ssl/tomcat.keystore \
  -e AUTH_KEYSTORE_PASS="$KEYSTORE_PASS" \
  -e SSL_CERT_PATH=/etc/opt/x1280/ssl/cert.pem \
  -e SSL_CERT_KEY_PATH=/etc/opt/x1280/ssl/privkey.pem \
  -v auth-settings:/opt/x1280/tomcat/conf/passwordless \
  -v auth-logs:/opt/x1280/tomcat/logs \
  -v user-connection-logs:/opt/x1280/connector/logs \
  -v push-request-logs:/opt/x1280/pushConnector/logs \
  -v config:/etc/opt/x1280 \
  -v database:/var/lib/mysql \
  -v /home/ssl:/etc/opt/x1280/ssl:ro \
  -p 8006:8005 \
  -p 8080:8080 \
  -p 8180:8180 \
  -p 8143:8143 \
  -p 8443:8443 \
  -p 11040:11040 \
  -p 12010:12010 \
  -p 15010:15010 \
  dualauth/passwordless-x1280-single:latest

# Lets Encrypt 갱신 후 X1280 Keystore도 다시 만드는 Deploy Hook 생성
cat > /etc/letsencrypt/renewal-hooks/deploy/passwordless-x1280.sh <<EOF_HOOK
#!/usr/bin/env bash
set -euo pipefail
DOMAIN="$DOMAIN"
KEYSTORE_PASS="$KEYSTORE_PASS"
cp "/etc/letsencrypt/live/\$DOMAIN/fullchain.pem" /home/ssl/cert.pem
cp "/etc/letsencrypt/live/\$DOMAIN/privkey.pem" /home/ssl/privkey.pem
openssl pkcs12 -export -in /home/ssl/cert.pem -inkey /home/ssl/privkey.pem -out /home/ssl/tomcat.p12 -name tomcat -passout pass:"\$KEYSTORE_PASS"
rm -f /home/ssl/tomcat.keystore
keytool -importkeystore -noprompt -deststorepass "\$KEYSTORE_PASS" -destkeystore /home/ssl/tomcat.keystore -srckeystore /home/ssl/tomcat.p12 -srcstoretype PKCS12 -srcstorepass "\$KEYSTORE_PASS"
chmod 600 /home/ssl/privkey.pem /home/ssl/tomcat.keystore /home/ssl/tomcat.p12
chmod 644 /home/ssl/cert.pem
docker restart server
EOF_HOOK

# Deploy Hook 실행 권한 및 Certbot 자동 갱신 Timer 활성화
chmod 700 /etc/letsencrypt/renewal-hooks/deploy/passwordless-x1280.sh
systemctl enable --now certbot.timer 2>/dev/null || true